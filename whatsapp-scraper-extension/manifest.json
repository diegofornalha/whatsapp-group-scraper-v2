{
  "manifest_version": 3,
  "name": "WhatsApp 20x",
  "version": "1.1.0",
  "description": "Multiplique seus resultados no WhatsApp",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; form-action 'none'"
  },
  "action": {
    "default_title": "WhatsApp 20x - Clique para abrir WhatsApp Web",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["js/inject-button.js"],
      "css": ["css/button-style.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
